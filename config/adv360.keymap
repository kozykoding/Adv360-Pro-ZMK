#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        backspace_td: backspace_td {
            compatible = "zmk,behavior-tap-dance";
            label = "BACKSPACE_TD";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp RC(BACKSPACE)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC         &kp N1                &kp N2  &kp N3        &kp N4  &kp N5  &kp PRINTSCREEN                                                                                &mo 3                         &kp N6  &kp N7          &kp N8          &kp N9        &kp N0           &kp DELETE
&kp GRAVE       &kp Q                 &kp W   &kp E         &kp R   &kp T   &kp LS(KP_LEFT_PARENTHESIS)                                                                    &kp LS(KP_RIGHT_PARENTHESIS)  &kp Y   &kp U           &kp I           &kp O         &kp P            &kp BSLH
&kp TAB         &kp A                 &kp S   &kp D         &kp F   &kp G   &kp LEFT_BRACKET             &kp LC(INSERT)  &kp LS(INSERT)      &kp PLUS       &kp EQUAL      &kp RIGHT_BRACKET             &kp H   &kp J           &kp K           &kp L         &kp SEMI         &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z                 &kp X   &kp C         &kp V   &kp B                                                &kp LC(S)           &kp MINUS                                                   &kp N   &kp M           &kp COMMA       &kp DOT       &kp FSLH         &kp RSHFT
&kp LCTRL       &kp LS(LEFT_CONTROL)  &mo 1   &kp LC(LGUI)  &mo 2           &kp RET                      &none           &kp LEFT_GUI        &kp RIGHT_ALT  &backspace_td  &kp SPACE                             &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none           &none  &none  &none  &none  &none  &trans                                                        &kp KP_NUMLOCK  &none  &none            &none      &none       &none  &kp MINUS
&none           &none  &none  &none  &none  &none  &none                                                         &kp ASTERISK    &none  &kp KP_N7        &kp KP_N8  &kp KP_N9   &none  &none
&kp TAB         &none  &none  &none  &none  &none  &none      &none  &kp ASTERISK      &kp PLUS   &kp EQUAL      &kp SLASH       &none  &kp KP_N4        &kp KP_N5  &kp KP_N6   &none  &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &none                    &kp SLASH         &kp MINUS                                 &none  &kp KP_N1        &kp KP_N2  &kp KP_N3   &none  &none
&none           &none  &none  &none  &none         &kp ENTER  &none  &none             &none      &kp BACKSPACE  &kp SPACE              &kp KP_NUMBER_0  &none      &kp KP_DOT  &none  &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1           &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                       &none   &kp F7          &kp F8          &kp F9        &kp F10          &kp F11  &kp F12
&none            &none   &trans  &trans  &trans  &trans  &none                                       &none   &trans          &trans          &trans        &trans           &trans   &kp LA(C_VOLUME_UP)
&kp PRINTSCREEN  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none    &kp LA(C_VOLUME_DOWN)
&trans           &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &none           &trans          &trans        &trans           &none    &trans
&trans           &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                  &trans          &trans        &trans           &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &trans      &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
